# Vorlage fuer .env. Die echte .env wird NICHT eingecheckt.
# Kopieren mit:  cp .env.example .env   und dann ausfuellen.

# --- Datenbank ---
POSTGRES_DB=rotaskat
POSTGRES_USER=rotaskat
# Starkes Passwort erzeugen, z.B.:  openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Oeffentliche Erreichbarkeit ---
# Die Domain, unter der der Server erreichbar ist. Caddy zieht darauf
# automatisch ein Let's-Encrypt-Zertifikat.
ROTASKAT_DOMAIN=
# E-Mail fuer Let's-Encrypt-Benachrichtigungen (ablaufende Zertifikate).
ACME_EMAIL=

# --- App-Build ---
# Basis-URL, die in die APK gebacken wird. Im GitHub-Actions-Build kommt der
# Wert aus dem Secret ROTASKAT_SERVER_URL.
ROTASKAT_SERVER_URL=
